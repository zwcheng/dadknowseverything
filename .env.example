# Copy to .env and fill in. `.env` is git-ignored.
# NOTE: do not use `.env.local` with an empty key line — Vite's .local
# overrides .env and will blank out the key you just set.
VITE_GEMINI_API_KEY=

# Model knob. Speed/quality tradeoff:
#   gemini-2.5-flash        (default, solid quality, ~1–2s first token)
#   gemini-2.5-flash-lite   (~30–50% faster, slightly less nuanced phrasing)
#   gemini-2.0-flash        (older, fastest, audio input supported)
VITE_GEMINI_MODEL=gemini-2.5-flash
